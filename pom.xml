<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.riyaz</groupId>
    <artifactId>java-stream-interview-suite</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Java Stream Interview Practice Suite</name>
    <description>50 curated Java Stream API interview problems with JUnit 5 tests</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <junit.version>5.10.2</junit.version>
        <assertj.version>3.25.3</assertj.version>
        <!-- Candidate tests only: Level1Test … Level5Test (not *ReferenceTest). -->
        <surefire.includes>**/Level?Test.java</surefire.includes>
        <surefire.excludes>**/*ReferenceTest.java</surefire.excludes>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>${surefire.includes}</include>
                    </includes>
                    <excludes>
                        <exclude>${surefire.excludes}</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>reference</id>
            <properties>
                <surefire.includes>**/Level?ReferenceTest.java</surefire.includes>
                <surefire.excludes>**/NONE.java</surefire.excludes>
            </properties>
        </profile>
        <profile>
            <id>level1</id>
            <properties>
                <surefire.includes>**/Level1Test.java</surefire.includes>
                <surefire.excludes>**/*ReferenceTest.java</surefire.excludes>
            </properties>
        </profile>
        <profile>
            <id>level2</id>
            <properties>
                <surefire.includes>**/Level2Test.java</surefire.includes>
                <surefire.excludes>**/*ReferenceTest.java</surefire.excludes>
            </properties>
        </profile>
        <profile>
            <id>level3</id>
            <properties>
                <surefire.includes>**/Level3Test.java</surefire.includes>
                <surefire.excludes>**/*ReferenceTest.java</surefire.excludes>
            </properties>
        </profile>
        <profile>
            <id>level4</id>
            <properties>
                <surefire.includes>**/Level4Test.java</surefire.includes>
                <surefire.excludes>**/*ReferenceTest.java</surefire.excludes>
            </properties>
        </profile>
        <profile>
            <id>level5</id>
            <properties>
                <surefire.includes>**/Level5Test.java</surefire.includes>
                <surefire.excludes>**/*ReferenceTest.java</surefire.excludes>
            </properties>
        </profile>
        <profile>
            <id>all-tests</id>
            <properties>
                <surefire.includes>**/Level*Test.java</surefire.includes>
                <surefire.excludes>**/NONE.java</surefire.excludes>
            </properties>
        </profile>
    </profiles>
</project>
